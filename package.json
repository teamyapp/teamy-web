{
    "name": "teamy-web",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "start:base": "craco start",
        "start": "dotenv -e .env.development -- yarn start:base",
        "start:testing": "dotenv -e .env.testing -- yarn start:base",
        "start:staging": "dotenv -e .env.staging -- yarn start:base",
        "start:production": "dotenv -e .env.production -- yarn start:base",
        "build:base": "craco build",
        "build": "dotenv -e .env.production yarn build:base",
        "build:development": "dotenv -e .env.development yarn build:base",
        "build:testing": "dotenv -e .env.testing yarn build:base",
        "build:staging": "dotenv -e .env.staging yarn build:base",
        "build:production": "dotenv -e .env.production yarn build:base",
        "test": "dotenv -e .env.testing -- craco test",
        "test:e2e": "playwright test",
        "eject": "craco eject",
        "format": "yarn prettier --write .",
        "storybook": "start-storybook -p 6006",
        "build-storybook": "build-storybook -o docs"
    },
    "dependencies": {
        "@teamyapp/ext": "0.0.3",
        "classnames": "^2.3.1",
        "graphql": "^16.1.0",
        "js-cookie": "^3.0.1",
        "lodash-es": "^4.17.21",
        "marked": "^3.0.7",
        "material-symbols": "^0.4.2",
        "moment": "^2.29.1",
        "prismjs": "^1.25.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "uuid": "^9.0.0",
        "web-vitals": "^1.0.1"
    },
    "devDependencies": {
        "@craco/craco": "^6.4.3",
        "@playwright/test": "^1.23.1",
        "@storybook/addon-actions": "^6.4.9",
        "@storybook/addon-essentials": "^6.4.9",
        "@storybook/addon-links": "^6.4.9",
        "@storybook/node-logger": "^6.4.9",
        "@storybook/preset-create-react-app": "^3.2.0",
        "@storybook/react": "^6.4.9",
        "@testing-library/jest-dom": "^5.11.4",
        "@testing-library/react": "^11.1.0",
        "@testing-library/user-event": "^12.1.10",
        "@trivago/prettier-plugin-sort-imports": "^3.1.1",
        "@types/jest": "^26.0.15",
        "@types/js-cookie": "^3.0.0",
        "@types/lodash-es": "^4.17.5",
        "@types/marked": "^3.0.1",
        "@types/node": "^12.0.0",
        "@types/prismjs": "^1.16.6",
        "@types/react": "^18.0.17",
        "@types/react-dom": "^18.0.6",
        "@types/uuid": "^8.3.4",
        "babel-loader": "8.1.0",
        "craco-alias": "^3.0.1",
        "craco-esbuild": "^0.4.2",
        "dotenv-cli": "^4.1.0",
        "git-revision-webpack-plugin": "^5.0.0",
        "prettier": "2.4.1",
        "react-scripts": "4.0.3",
        "sass": "^1.43.4",
        "tsconfig-paths-webpack-plugin": "^3.5.2",
        "typescript": "4.4.4",
        "webpack": "4.44.2"
    },
    "resolutions": {
        "react-error-overlay": "6.0.9"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ],
        "overrides": [
            {
                "files": [
                    "**/*.stories.*"
                ],
                "rules": {
                    "import/no-anonymous-default-export": "off"
                }
            }
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "jest": {
        "moduleNameMapper": {
            "^@core/dep/(.*)": "<rootDir>/src/dep/$1",
            "^@lib/testing/(.*)": "<rootDir>/src/libs/testing/$1",
            "^@lib/(.*)": "<rootDir>/src/libs/$1"
        }
    },
    "babel": {
        "presets": [
            "@babel/preset-typescript"
        ]
    }
}
