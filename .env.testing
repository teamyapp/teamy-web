VITE_ENVIRONMENT=testing

# Teamy
VITE_SERVICES_WEB_API_ENDPOINT=https://web-backend.testing.teamyapp.com
VITE_SERVICES_WEB_SOCKET_API_ENDPOINT=wss://web-backend.testing.teamyapp.com
VITE_CLOUD_WEB_API_ENDPOINT=https://cloud.testing.teamyapp.com
VITE_DEFAULT_LOG_LEVEL=Debug
VITE_MAX_API_RETRY_TIMES=10
VITE_LONG_BACK_OFF_MIN_DELAY_MS=10000
VITE_LONG_BACK_OFF_MAX_DELAY_MS=60000

# Identity
VITE_IDENTITY_API_BASE_ENDPOINT=https://cloud.testing.teamyapp.com/identity
VITE_IDENTITY_COOKIE_DOMAIN=testing.teamyapp.com
VITE_IDENTITY_COOKIE_SECURE=true
VITE_IDENTITY_SIGN_IN_LINK=/cloud/identity/sign-in
VITE_IDENTITY_SIGN_IN_FINISH_LINK=/cloud/identity/sign-in-finish