{
    "name": "react-web",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "start": "vite",
        "start:staging": "vite --mode staging",
        "start:production": "vite --mode production",
        "start:testing": "vite --mode testing",
        "build:base": "vite build",
        "build": "yarn build:base",
        "build:development": "yarn build:base --mode development",
        "build:testing": "yarn build:base --mode testing",
        "build:staging": "yarn build:base --mode staging",
        "test": "NODE_OPTIONS=--experimental-vm-modules yarn jest",
        "format": "yarn prettier --write .",
        "storybook": "start-storybook -p 6006",
        "build-storybook": "build-storybook -o docs"
    },
    "dependencies": {
        "@apollo/client": "^3.5.6",
        "classnames": "^2.3.1",
        "graphql": "^16.1.0",
        "js-cookie": "^3.0.1",
        "lodash-es": "^4.17.21",
        "marked": "^3.0.7",
        "material-icons": "^1.9.0",
        "moment": "^2.29.1",
        "prismjs": "^1.25.0",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "react-router-dom": "^5.3.0",
        "web-vitals": "^1.0.1"
    },
    "devDependencies": {
        "@storybook/addon-actions": "^6.4.9",
        "@storybook/addon-essentials": "^6.4.9",
        "@storybook/addon-links": "^6.4.9",
        "@storybook/node-logger": "^6.4.9",
        "@storybook/preset-create-react-app": "^3.2.0",
        "@storybook/react": "^6.4.9",
        "@swc/core": "^1.2.124",
        "@swc/jest": "^0.2.15",
        "@testing-library/jest-dom": "^5.16.1",
        "@testing-library/react": "^11.1.0",
        "@testing-library/user-event": "^12.1.10",
        "@trivago/prettier-plugin-sort-imports": "^3.1.1",
        "@types/jest": "^26.0.15",
        "@types/js-cookie": "^3.0.0",
        "@types/lodash-es": "^4.17.5",
        "@types/marked": "^3.0.1",
        "@types/node": "^12.0.0",
        "@types/prismjs": "^1.16.6",
        "@types/react": "^17.0.0",
        "@types/react-dom": "^17.0.0",
        "@types/react-router-dom": "^5.3.0",
        "@vitejs/plugin-react": "^1.1.3",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^27.4.5",
        "prettier": "2.4.1",
        "sass": "^1.43.4",
        "typescript": "4.4.4",
        "vite": "^2.7.10",
        "vite-jest": "^0.1.4",
        "vite-tsconfig-paths": "^3.3.17"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ],
        "overrides": [
            {
                "files": [
                    "**/*.stories.*"
                ],
                "rules": {
                    "import/no-anonymous-default-export": "off"
                }
            }
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
