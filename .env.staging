VITE_ENVIRONMENT=staging

# Teamy
VITE_SERVICES_WEB_API_ENDPOINT=https://web-backend.staging.teamyapp.com
VITE_SERVICES_WEB_SOCKET_API_ENDPOINT=wss://web-backend.staging.teamyapp.com
VITE_CLOUD_WEB_API_ENDPOINT=https://cloud.staging.teamyapp.com
VITE_DEFAULT_LOG_LEVEL=Info
VITE_MAX_API_RETRY_TIMES=10
VITE_LONG_BACK_OFF_MIN_DELAY_MS=10000 # 10 seconds
VITE_LONG_BACK_OFF_MAX_DELAY_MS=60000 # 1 minute

# Identity
VITE_IDENTITY_API_BASE_ENDPOINT=https://cloud.staging.teamyapp.com/identity
VITE_IDENTITY_COOKIE_DOMAIN=localhost
VITE_IDENTITY_COOKIE_SECURE=false
#VITE_IDENTITY_COOKIE_DOMAIN=staging.teamyapp.com
#VITE_IDENTITY_COOKIE_SECURE=true
VITE_IDENTITY_SIGN_IN_LINK=/cloud/identity/sign-in
VITE_IDENTITY_SIGN_IN_FINISH_LINK=/cloud/identity/sign-in-finish

# Feature toggles
VITE_TOGGLE_ENABLE_INSIGHTS=false
VITE_TOGGLE_ENABLE_PLANNING_DOC=false
VITE_TOGGLE_ENABLE_KNOWLEDGE_BASE=false
VITE_TOGGLE_ENABLE_HELP_CENTER=false
VITE_TOGGLE_ENABLE_MARKETPLACE=false