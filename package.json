{
    "name": "react-web",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "start:base": "craco start",
        "start": "dotenv -e .env.development -- yarn start:base",
        "start:staging": "dotenv -e .env.staging -- yarn start:base",
        "start:production": "dotenv -e .env.production -- yarn start:base",
        "start:testing": "dotenv -e .env.testing -- yarn start:base",
        "build:base": "craco build",
        "build": "dotenv -e .env.production yarn build:base",
        "build:development": "dotenv -e .env.development yarn build:base",
        "build:testing": "dotenv -e .env.testing yarn build:base",
        "build:staging": "dotenv -e .env.staging yarn build:base",
        "test": "dotenv -e .env.testing -- craco test",
        "eject": "craco eject",
        "format": "yarn prettier --write .",
        "storybook": "start-storybook -p 6006 -s public",
        "build-storybook": "build-storybook -s public -o docs"
    },
    "dependencies": {
        "@creatcodebuild/csp": "^0.0.6",
        "@reduxjs/toolkit": "^1.6.2",
        "classnames": "^2.3.1",
        "js-cookie": "^3.0.1",
        "lodash-es": "^4.17.21",
        "marked": "^3.0.7",
        "material-icons": "^1.9.0",
        "moment": "^2.29.1",
        "prismjs": "^1.25.0",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "react-redux": "^7.2.5",
        "react-router-dom": "^5.3.0",
        "web-vitals": "^1.0.1"
    },
    "devDependencies": {
        "@craco/craco": "^6.4.1",
        "@storybook/addon-actions": "^6.3.8",
        "@storybook/addon-essentials": "^6.3.8",
        "@storybook/addon-links": "^6.3.8",
        "@storybook/node-logger": "^6.3.8",
        "@storybook/preset-create-react-app": "^3.2.0",
        "@storybook/react": "^6.3.8",
        "@testing-library/jest-dom": "^5.11.4",
        "@testing-library/react": "^11.1.0",
        "@testing-library/user-event": "^12.1.10",
        "@types/jest": "^26.0.15",
        "@types/js-cookie": "^3.0.0",
        "@types/lodash-es": "^4.17.5",
        "@types/marked": "^3.0.1",
        "@types/node": "^12.0.0",
        "@types/prismjs": "^1.16.6",
        "@types/react": "^17.0.0",
        "@types/react-dom": "^17.0.0",
        "@types/react-router-dom": "^5.3.0",
        "babel-loader": "8.1.0",
        "craco-swc": "^0.1.3",
        "dotenv-cli": "^4.1.0",
        "prettier": "2.4.1",
        "react-scripts": "4.0.3",
        "sass": "^1.43.4",
        "typescript": "^4.1.2"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ],
        "overrides": [
            {
                "files": [
                    "**/*.stories.*"
                ],
                "rules": {
                    "import/no-anonymous-default-export": "off"
                }
            }
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
