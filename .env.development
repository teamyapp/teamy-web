VITE_ENVIRONMENT=development

# Teamy
VITE_SERVICES_WEB_API_ENDPOINT=http://localhost:9000
VITE_SERVICES_WEB_SOCKET_API_ENDPOINT=ws://localhost:9000
VITE_CLOUD_WEB_API_ENDPOINT=http://localhost:9011
VITE_DEFAULT_LOG_LEVEL=Debug
VITE_MAX_API_RETRY_TIMES=10
VITE_LONG_BACK_OFF_MIN_DELAY_MS=10000 # 10 seconds
VITE_LONG_BACK_OFF_MAX_DELAY_MS=60000 # 1 minute

# Identity
VITE_IDENTITY_API_BASE_ENDPOINT=http://localhost:9011/identity
VITE_IDENTITY_COOKIE_DOMAIN=localhost
VITE_IDENTITY_COOKIE_SECURE=false
VITE_IDENTITY_SIGN_IN_LINK=/cloud/identity/sign-in
VITE_IDENTITY_SIGN_IN_FINISH_LINK=/cloud/identity/sign-in/finish

# Feature toggles
VITE_TOGGLE_ENABLE_INSIGHTS=true
VITE_TOGGLE_ENABLE_PLANNING_DOC=true
VITE_TOGGLE_ENABLE_KNOWLEDGE_BASE=true
VITE_TOGGLE_ENABLE_HELP_CENTER=true
VITE_TOGGLE_ENABLE_MARKETPLACE=true